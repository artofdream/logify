# Generated HTML reports. Keep the glob; also name common files explicitly
# because `/*-report.html` does not match `report.html`, and a named list is
# easier to audit on Windows than a leading-glob pattern alone.
/*-report.html
/sample-report.html
/report.html
/nfr009-report.html

